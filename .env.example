PORT=3000
NODE_ENV=development
DB_HOST=10.0.60.33
DB_PORT=1433
DB_USER=pmcweb_app
DB_PASSWORD=changeme
DB_NAME=PMCweb
# true khi kết nối qua mạng không tin cậy / Azure.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# User có quyền DDL, chỉ dùng cho scripts/migrate.js. Bỏ trống → dùng DB_USER.
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=
SESSION_SECRET=replace-with-64-random-chars
# true chỉ khi người dùng truy cập bằng HTTPS. Chạy HTTP mà để true → không đăng nhập được.
COOKIE_SECURE=false
# 1 khi chạy sau reverse proxy (IIS/nginx) kết thúc HTTPS.
TRUST_PROXY=0
# MES công ty — lấy màu thực tế cho Gantt. Bỏ trống user/pass → tắt đồng bộ.
